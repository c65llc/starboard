wrote docs/flows/generated/screens.md
wrote docs/flows/generated/wireframes/home.main.phone.svg
wrote docs/flows/screens.yaml
wrote starboard.yaml
0 errors, 0 warnings
-- clean.txt --
0 errors, 0 warnings
-- clean.json --
{
  "version": 1,
  "errors": [],
  "warnings": []
}
-- want-removed.txt --
removed docs/flows/generated/wireframes/old.screen.phone.svg
