# fmt --check lists the files that are not in canonical form and exits 1,
# writing nothing; fmt rewrites them and lists them.
exits 1 starboard fmt --check
cmp stdout want-paths.txt
! stderr .
cmp starboard.yaml before-starboard.yaml

exec starboard fmt
cmp stdout want-paths.txt
cmp starboard.yaml want-starboard.yaml
cmp docs/flows/screens.yaml want-screens.yaml
cmp docs/flows/flows/a.md want-a.md

exec starboard fmt --check
! stdout .
exec starboard fmt
! stdout .
exec starboard generate
exec starboard lint
stdout '^0 errors, 0 warnings$'

# Paths are relative to the project root, from any directory in it.
cp before-starboard.yaml starboard.yaml
cd docs
exits 1 starboard fmt --check
stdout '^starboard.yaml$'
cd $WORK

# A screens.yaml that cannot be read is reported, and fails fmt and
# fmt --check, though the other files are still formatted.
cp broken-screens.yaml docs/flows/screens.yaml
exits 1 starboard fmt --check
stderr '^docs/flows/screens.yaml:2: error yaml-syntax: '
stdout '^starboard.yaml$'
! stderr 'cannot format'
cmp starboard.yaml before-starboard.yaml
exits 1 starboard fmt
stderr '^docs/flows/screens.yaml:2: error yaml-syntax: '
cmp starboard.yaml want-starboard.yaml

# A file the formatter refuses fails fmt and fmt --check, and is named.
cp undroppable.yaml docs/flows/screens.yaml
exits 1 starboard fmt --check
stderr '^cannot format docs/flows/screens.yaml: formatting would drop a comment: #$'
exits 1 starboard fmt
stderr '^cannot format docs/flows/screens.yaml: formatting would drop a comment: #$'
cmp docs/flows/screens.yaml undroppable.yaml
exits 1 starboard lint
stdout '^docs/flows/screens.yaml: error not-formatted: cannot be formatted: formatting would drop a comment: #$'
cp want-screens.yaml docs/flows/screens.yaml

# A starboard.yaml that cannot be read is reported, and nothing is written.
cp broken.yaml starboard.yaml
exits 1 starboard fmt
stderr '^starboard.yaml:1: error yaml-syntax: '
! stdout .
exits 2 starboard fmt extra
stderr 'fmt takes no arguments'

-- starboard.yaml --
version:   1
areas:
  - home
-- before-starboard.yaml --
version:   1
areas:
  - home
-- want-starboard.yaml --
version: 1
areas: [home]
-- docs/flows/screens.yaml --
screens:
  home.main:
    presentation: root
    title: Home
    area: home
    purpose: Start here.
-- want-screens.yaml --
screens:
  home.main:
    title: Home
    area: home
    purpose: Start here.
    presentation: root
-- docs/flows/flows/a.md --
---
title: A
id: a
status: proposed
actors: [person]
entry: home.main
---

# A


1. Open @home.main.
-- want-a.md --
---
id: a
title: A
status: proposed
actors: [person]
entry: home.main
---

# A

1. Open @home.main.
-- want-paths.txt --
docs/flows/flows/a.md
docs/flows/screens.yaml
starboard.yaml
-- broken-screens.yaml --
screens:
  home.main: [
-- undroppable.yaml --
[[[]#
]#
]
-- broken.yaml --
version: [1
