# Every command-line example in the documentation the site publishes runs
# against the binary: each ```bash block marked <!-- verified: … --> runs in a
# copy of an example project (or an empty directory), each command must exit
# as the marker says, and an <!-- output --> block after it must be exactly
# its stdout. A starboard command in any other shell block, or a GitHub
# Action "args:" line, must be a verbatim copy of a verified one. The markers
# are described in docs_test.go.
verifydocs $REPO $REPO/docs/getting-started $REPO/docs/concepts $REPO/docs/reference $REPO/docs/guides $REPO/docs/rules $REPO/website/src/content/docs/blog
stdout '^verified [1-9][0-9]* blocks, [1-9][0-9]* commands, in [1-9][0-9]* pages$'

# The checker itself: a page whose examples hold passes.
verifydocs $REPO good
stdout '^verified 4 blocks, 6 commands, in 1 pages$'

# A command or flag the binary no longer has fails its block.
! verifydocs $REPO removed-flag
stderr '^removed-flag/page.md:5: starboard lint --pretty: exit status 2, want 0$'
! verifydocs $REPO removed-command
stderr '^removed-command/page.md:5: starboard check: exit status 2, want 0$'

# Output that no longer matches fails.
! verifydocs $REPO wrong-output
stderr '^wrong-output/page.md:9: the output block differs'

# An example nobody runs, in a shell block or an Action's args, fails.
! verifydocs $REPO unverified
stderr '^unverified/page.md:9: "starboard lint --strict" is not in any verified block$'
stderr '^unverified/page.md:14: args "fmt --check": "starboard fmt --check" is not in any verified block$'

# Shell syntax, a non-starboard command and a bad marker are refused.
! verifydocs $REPO bad
stderr '^bad/page.md:4: <!-- output --> does not follow a verified block$'
stderr '^bad/page.md:10: "starboard lint \| cat": only plain starboard commands can be verified$'
stderr '^bad/page.md:15: "ls" is not a starboard command$'
stderr '^bad/page.md:19: unknown SOURCE "nowhere": use empty or examples/<name>$'
stderr '^bad/page.md:24: a verified block must be ```bash, not "sh"$'
stderr '^bad/page.md:29: starboard.yaml differs from the block:$'
stderr '^bad/page.md:33: cannot remove no/such/file.md: '

# A marker with no block after it is an error, in the text or at the end.
! verifydocs $REPO dangling
stderr '^dangling/page.md:3: <!-- verified --> is not followed by a fenced block$'
stderr '^dangling/page.md:7: <!-- output --> is not followed by a fenced block$'

-- good/page.md --
# Good

