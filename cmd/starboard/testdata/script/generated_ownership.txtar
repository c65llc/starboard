# With content ".", generated/ may hold another tool's files. generate and
# lint --fix only ever write, report or remove starboard's own outputs:
# generated/app-map.md, generated/screens.md and generated/wireframes/*.svg.
exec starboard generate
cmp stdout want-generate.txt
exists generated/api/types.pb.go generated/README.md generated/wireframes/keep/inner.svg
! exists generated/wireframes/old.phone.svg
exec starboard lint
stdout '^0 errors, 1 warning$'

cp old.svg generated/wireframes/old.phone.svg
exits 1 starboard lint
stdout '^generated/wireframes/old.phone.svg: error generated-stale: generated/wireframes/old.phone.svg is no longer generated by starboard; remove it$'
stdout '^1 error, 1 warning$'
exec starboard lint --fix
stdout '^removed generated/wireframes/old.phone.svg$'
! exists generated/wireframes/old.phone.svg
exists generated/api/types.pb.go generated/README.md generated/wireframes/keep/inner.svg

-- starboard.yaml --
version: 1
content: .
platforms:
  ios:
    formFactors: [phone]
areas: [home]
-- screens.yaml --
screens:
  home.main:
    title: Home
    area: home
    purpose: The first screen.
    presentation: root
    layout:
      - {region: title, kind: header, label: App}
-- generated/api/types.pb.go --
package api
-- generated/README.md --
Generated by protoc.
-- generated/wireframes/keep/inner.svg --
<svg/>
-- generated/wireframes/old.phone.svg --
<svg/>
-- old.svg --
<svg/>
-- want-generate.txt --
wrote generated/app-map.md
wrote generated/screens.md
wrote generated/wireframes/home.main.phone.svg
removed generated/wireframes/old.phone.svg
