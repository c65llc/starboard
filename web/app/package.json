{
  "name": "@c65llc/starboard-app",
  "version": "0.1.0",
  "private": true,
  "description": "Starboard's local-first web app: open a project folder, view and edit its screens and flows",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:embed": "vite build -c vite.config.embed.ts",
    "build:desktop": "vite build -c vite.config.desktop.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/generate-icons.ts"
  },
  "dependencies": {
    "@c65llc/starboard-core": "workspace:*",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@preact/signals": "2.11.4",
    "@tauri-apps/api": "2.12.5",
    "dompurify": "3.5.0",
    "elkjs": "0.12.1",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "mermaid": "12.3.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-window": "7.4.1"
  }
}
