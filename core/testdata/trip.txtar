A small trip-planning project for the core tests: a timeline with a
web-wide layout override, a sheet editor proposed on the web, a three-step
flow whose first step is @trip.timeline#add-activity, and a flow with a step
that has no reference.
-- starboard.yaml --
version: 1
platforms:
  ios:
    formFactors: [phone]
  web:
    formFactors: [web-wide]
areas: [trip, activity]
-- docs/flows/screens.yaml --
screens:
  trip.timeline:
    title: Timeline
    area: trip
    purpose: The trip's days in order.
    presentation: root
    layout:
      - region: app-bar
        kind: bar
        children:
          - {region: title, kind: text, label: Trip name}
      - region: activities
        kind: list
        item: {kind: card, label: Activity, to: activity.editor}
        empty: {label: No activities yet}
      - {region: add-activity, kind: primary-action, label: Add activity, to: activity.editor, requires: editLogistics}
      - region: tabs
        kind: tabs
        items:
          - {label: Timeline, to: trip.timeline}
          - {label: Costs, to: trip.timeline, status: proposed}
    layouts:
      web-wide:
        - region: shell
          kind: row
          children:
            - {region: side, kind: nav, width: 240}
            - {region: add-activity, kind: primary-action, label: Add activity, width: 1/3, to: activity.editor}
  activity.editor:
    title: Activity editor
    area: activity
    purpose: Create or change one activity.
    presentation: sheet
    status:
      ios: shipped
      web: proposed
    layout:
      - {region: title, kind: field, label: Title}
      - {region: save, kind: primary-action, label: Save, to: trip.timeline}
-- docs/flows/flows/add-activity.md --
---
id: add-activity
title: Add an activity
status: proposed
entry: trip.timeline
---

## Steps

1. Tap @trip.timeline#add-activity.
   - If the trip is read-only, the button is hidden.
2. Name it in @activity.editor#title.
3. Tap @activity.editor#save.
-- docs/flows/flows/browse.md --
---
id: browse
title: Browse the trip
status: shipped
entry: trip.timeline
---

## Steps

1. Open @trip.timeline.
2. Scroll through the days.
