// SPDX-License-Identifier: AGPL-3.0-only
// Copyright 2026 C65 LLC
//
// The `starboard` Worker that serves https://starboard.c65llc.com: static
// assets only, no script. Its assets are the `live` branch (the BUILT site),
// checked out into website/live/ (gitignored) by publish.yml's `deploy` job,
// which runs `wrangler deploy --config website/wrangler.jsonc`. Paths here
// are relative to this file. This file is source: it lives beside the site,
// not in public/, so it is never part of the built site or of `live`.
// See docs/releasing.md, "Publishing the website".
{
  "name": "starboard",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "starboard.c65llc.com", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "live",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
